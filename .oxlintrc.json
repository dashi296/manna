{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "jsx-a11y",
    "vitest",
    "import",
    "promise"
  ],
  "jsPlugins": [
    "@shadcn/lint"
  ],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "vitest/require-mock-type-parameters": "off",
    "unicorn/no-array-sort": "error",
    "shadcn/no-inline-styles": "error",
    "shadcn/no-arbitrary-values": [
      "error",
      {
        "allow": [
          "bottom-[calc(var(--bottom-nav-h)+var(--install-banner-h)+1rem)]",
          "bottom-[var(--bottom-nav-h)]",
          "grid-cols-[1fr_auto_1fr]",
          "h-[70dvh]",
          "max-h-[50dvh]",
          "max-h-[70vh]",
          "max-h-[92dvh]",
          "min-h-[60vh]",
          "pb-[var(--bottom-nav-h)]",
          "pb-[var(--fab-clearance)]",
          "pb-[var(--safe-area-bottom)]",
          "pt-[var(--page-header-pt)]",
          "pt-[var(--selection-header-pt)]",
          "w-[min(520px,40vw)]"
        ]
      }
    ],
    "shadcn/no-raw-colors": "error",
    "shadcn/require-static-classes": "error",
    "shadcn/no-unknown-classes": [
      "error",
      {
        "allow": [
          "toaster"
        ]
      }
    ]
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    "apps/pwa/src/routeTree.gen.ts",
    "packages/database/index.ts"
  ],
  "settings": {
    "shadcn": {
      "ui": "@/shared/ui"
    }
  },
  "overrides": [
    {
      "files": [
        "apps/pwa/tests/**"
      ],
      "rules": {
        "shadcn/no-unknown-classes": "off"
      }
    },
    {
      "files": [
        "apps/pwa/src/shared/ui/menu.tsx",
        "apps/pwa/src/shared/ui/popover.tsx",
        "apps/pwa/src/shared/ui/sheet.tsx",
        "apps/pwa/src/shared/ui/sidebar.tsx",
        "apps/pwa/src/shared/ui/toggle-group.tsx",
        "apps/pwa/src/shared/ui/tooltip.tsx"
      ],
      "rules": {
        "shadcn/no-arbitrary-values": "off"
      }
    }
  ]
}
