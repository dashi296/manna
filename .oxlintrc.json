{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "jsx-a11y",
    "vitest",
    "import",
    "promise"
  ],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "vitest/require-mock-type-parameters": "off"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    "apps/pwa/src/routeTree.gen.ts",
    "packages/database/index.ts"
  ]
}
